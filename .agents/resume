#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

# Services are supervised by Amp; resume must never reinstall dependencies.
test -d node_modules
test -x apps/flue/node_modules/.bin/flue
test -f apps/flue/dist/server.mjs
test -f .local/orb-postgres/PG_VERSION
test -s .local/flue-token
echo 'Orb dependencies are ready. Use amp orb services ensure to start PostgreSQL, Zero, Flue and web.'
